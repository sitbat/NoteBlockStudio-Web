[Unit]
Description=Note Block Studio hosted web editor
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/noteblockstudio-web
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8765
EnvironmentFile=/etc/noteblockstudio-web.env
ExecStart=/usr/bin/node /opt/noteblockstudio-web/hosted-server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CPUQuota=200%
MemoryMax=1536M
TasksMax=64

[Install]
WantedBy=multi-user.target
