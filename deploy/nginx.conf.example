# Use an existing valid certificate and replace nbs.example.com and its paths.
server {
    listen 80;
    server_name nbs.example.com;
    return 301 https://nbs.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name nbs.example.com;
    ssl_certificate /etc/letsencrypt/live/nbs.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nbs.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128m;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-NBS-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 70s;
        proxy_read_timeout 150s;
        # COOP/COEP/CORP are already provided by the hosted backend.
        # Do not strip them or add duplicate values.
    }
}
