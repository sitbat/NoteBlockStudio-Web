# Exact website origin, without a path (external HTTPS/access are managed separately).
PUBLIC_ORIGIN=https://nbs.example.com
# Local application port; the container binds it on the host loopback interface.
APP_PORT=8765

# 0 keeps audio export in the browser (original-rate stereo WAV).
HOSTED_ENABLE_TRANSCODE=1
HOSTED_MAX_INPUT_MIB=128
HOSTED_MAX_OUTPUT_MIB=128
HOSTED_BODY_TIMEOUT_MS=20000
HOSTED_TRANSCODE_RATE=30
