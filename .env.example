# Hostname only, without https://, a path, or a trailing slash.
DOMAIN=nbs.example.com

# 0 keeps audio export in the browser (original-rate stereo WAV).
HOSTED_ENABLE_TRANSCODE=1
HOSTED_MAX_INPUT_MIB=128
HOSTED_MAX_OUTPUT_MIB=128
HOSTED_BODY_TIMEOUT_MS=20000
HOSTED_TRANSCODE_RATE=30

# Optional: uncomment basic_auth in deploy/Caddyfile and provide a Caddy hash.
# Single-quote hashes in this file so dollar signs are not interpolated.
# NBS_AUTH_USER=your-user
# NBS_AUTH_HASH='$2a$14$...'
